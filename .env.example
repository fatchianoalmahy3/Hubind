# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Sheets API v4 Fast Read & Write Path (Server-Side Only)
# If configured, server.ts reads (~200ms) and writes (~250ms, when shared as Editor)
# directly via Google Sheets API v4, avoiding GAS LockService contention during concurrent spikes.
# Option 1 (Recommended): Share sheet as Editor (or Viewer for read-only) to Service Account email.
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Option 2: Base64-encoded Service Account JSON (helpful on some deployment panels)
GOOGLE_SERVICE_ACCOUNT_B64=""
# Option 3: API Key fallback (read-only; only works if spreadsheet link sharing allows View)
GOOGLE_SHEETS_API_KEY=""

